{
  "deno.enable": true,
  "editor.formatOnSaveMode": "file",
  "chat.tools.terminal.autoApprove": {
    "/^deno test --unstable --allow-read --allow-net$/": {
      "approve": true,
      "matchCommandLine": true
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[typescript]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[json]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  },
  "[markdown]": {
    "editor.defaultFormatter": "denoland.vscode-deno"
  }
}
