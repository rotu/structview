{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext", "DOM"],
    "outDir": "dist",
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "bigendian.ts",
    "core.ts",
    "fields.ts",
    "mod.ts",
    "types.ts"
  ]
}
